FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PYTHONUNBUFFERED=1
# Pinned to the 2.x major on purpose. 2.0.0 renamed FastMCP to
# `mcp.server.mcpserver.MCPServer` and moved host/port from the constructor
# to run(); an unpinned install of that major crash-looped this container
# with `ModuleNotFoundError: No module named 'mcp.server.fastmcp'`. The next
# major can break the same way, and porting to it is deliberate work, not
# something an image rebuild should do silently. Ported to 2.x against 2.2.0.
RUN --mount=type=cache,target=/root/.cache/pip pip install 'mcp>=2.2,<3' httpx
COPY chronicle/ ./chronicle/
EXPOSE 8031
CMD ["python", "-m", "chronicle.mcp_server"]
