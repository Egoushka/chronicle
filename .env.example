# Copy to .env and fill in. .env is gitignored and never committed.

DB_PASSWORD=

# LiteLLM handles QUERY-TIME reasoning only (a few hundred calls/month over
# retrieved snippets). Bulk embedding runs on-box — that is the whole point.
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=

# Local embedding model. BGE-M3: ruMTEB retrieval avg 74.79, MIRACL-ru 70.16,
# 8192 ctx, 100+ languages incl. Ukrainian, dense+sparse+colbert heads.
EMBED_MODEL=BAAI/bge-m3

# Local model for batch enrichment. Runs only while chronicle-worker runs.
ENRICH_MODEL=qwen3:8b-q4_K_M
BATCH_SIZE=500
# Events per narrative segment. 15 won a sweep of 15/20/30 on the reference
# archive (CLAUDE.md, Status). Changing it affects NEW segments only; rebuild
# existing threads with `python -m chronicle.worker resegment --thread K`.
# SEGMENT_MAX_MESSAGES=15

# Whose archive this is. Enrichment names the owner's facts CHRONICLE_OWNER
# ("the owner" if empty) and treats CHRONICLE_OWNER_ALIASES (comma-separated,
# any script, any case) as the same person: other spellings, the full name,
# first-person pronouns such as i or я. "me" always is — telegram-sync writes
# it for outgoing messages.
CHRONICLE_OWNER=
CHRONICLE_OWNER_ALIASES=

# scripts/nightly.sh posts failures to this ntfy topic URL. Empty: log only.
NTFY_URL=

# --- sources (read-only; each one is independently droppable) ---
# telegram-sync is SQLite, NOT Postgres — a path, not a DSN. Mounted rw
# because the file is WAL; the adapter's `mode=ro` URI is what enforces
# read-only. See compose.yaml.
TELEGRAM_DB_URL=/srv/telegram/telegram.db
# Bot chats are excluded by default. A bot DM is a chat_type='user' chat, so
# `personal_only` never kept them out; without this, an assistant's own chat
# round-trips telegram-sync -> chronicle -> back to the assistant over MCP and
# it reads its own output as memory. Union of two signals: a `chat:bot` tag
# from telegram-sync, and the Telegram platform rule that every bot username
# ends in "bot". Set to 0 only if you want bots in the index.
TELEGRAM_EXCLUDE_BOT_CHATS=1
# Escape hatch in both directions, applied on top of the rule above: exclude a
# chat the heuristics miss, or record one they got wrong. Comma- or
# space-separated chat_ids; empty means none. Prefer the rule above where it
# works — a chat_id changes if the bot is recreated, a username does not.
TELEGRAM_EXCLUDE_CHAT_IDS=
# wakapi is SQLite too. WAKAPI_USER is the users.id column (a TEXT login),
# not the email.
WAKAPI_DB_PATH=/srv/wakapi/wakapi.db
WAKAPI_USER=
# PostGIS. `points.timestamp` is an integer epoch in 1.8.x, not a timestamp.
# DAWARICH_USER_ID is users.id — check it, the first account is rarely the
# one carrying the track.
DAWARICH_DB_URL=postgresql://dawarich:PASSWORD@dawarich_db:5432/dawarich
DAWARICH_USER_ID=

# Last.fm (tier 2): its key either here, or in a KEY=value secrets file shared
# by several stacks that scripts/nightly.sh and doctor-homelab.sh read in place.
LASTFM_API_KEY=
LASTFM_USER=
INGEST_SECRETS_FILE=

# --- tier 2+ sources (all optional, all independently droppable) ---
IMMICH_DB_URL=
IMMICH_OWNER_ID=
PAPERLESS_DB_URL=
FIREFLY_DB_URL=          # mysql://user:pass@firefly-db:3306/firefly  (MariaDB)
KARAKEEP_DB_PATH=        # /data/karakeep.db  (SQLite)
MINIFLUX_DB_URL=
FORGEJO_DB_URL=
FORGEJO_EMAIL=
OWNTRACKS_STORE=         # /store  (flat .rec JSONL; conflicts with dawarich)

# Pre-extraction gate for enrichment (optional; see README "Gating enrichment").
# GATE_BACKEND=jev
# GATE_KEY=            # a dedicated LiteLLM virtual key, with its own budget and rpm
# GATE_SKIP=0          # 0 = shadow (score, still extract); 1 = skip low scores
